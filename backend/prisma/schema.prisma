// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum ConflictSeverity {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskOrigin {
  USER
  AGENT
}

enum DocumentStatus {
  PENDING
  PROCESSED
  FAILED
}

// Better Auth required models

model User {
  id            String   @id @map("_id")
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  projects Project[]
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      ProjectStatus @default(ACTIVE)
  progress    Float         @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  documents Document[]
  tasks     Task[]
  chunks    Chunk[]

  functionalRequirements    FunctionalRequirement[]
  nonFunctionalRequirements NonFunctionalRequirement[]
  techStacks                TechStack[]
  conflicts                 Conflict[]
  missingInformation        MissingInformation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FunctionalRequirement {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  code        String // e.g. FR-1
  description String

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}

model NonFunctionalRequirement {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  code        String // e.g. NFR-2
  description String
  projectId   String  @db.ObjectId
  project     Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}

model TechStack {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  category String // e.g. "backend", "frontend", "database"
  stack    String[] // e.g. ["Node.js", "Express", "Prisma"]

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}

model Conflict {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  description String
  severity    ConflictSeverity

  resolved   Boolean @default(false)
  resolution String?

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}

model MissingInformation {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  description String

  addressed Boolean @default(false)
  note      String?

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}

model Document {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  fileName String
  fileType String
  status   DocumentStatus @default(PENDING)

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])

  chunks Chunk[]

  createdAt DateTime @default(now())
}

model Chunk {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  content String
  vector  Float[] // MongoDB Atlas Vector Search compatible
  source  String?

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])

  documentId String?   @db.ObjectId
  document   Document? @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())
}

model Task {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      TaskStatus @default(TODO)
  origin      TaskOrigin @default(USER)
  weight      Int        @default(1)

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}